# Server
PORT=3010
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...          # anon/public key (do painel Supabase > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service role key — NUNCA expor no frontend
DATABASE_URL=postgresql://user:password@localhost:5432/iris

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin
ADMIN_EMAIL=seu@email.com         # Promovido automaticamente para role=admin no startup

# Apify
APIFY_API_KEY=apify_api_...       # Chave de API do Apify (apify.com/settings/integrations)

# Email (Resend)
RESEND_API_KEY=re_...                # Chave de API do Resend (resend.com/api-keys)
RESEND_FROM_EMAIL=noreply@seudominio.com  # Remetente verificado no Resend

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# ─── Meta API (Epic 10) ────────────────────────────────────────────
# Instagram Business Login (sub-config IBL do app principal Meta)
IG_APP_ID=1226345842764674            # ID do app do Instagram (Casos de uso → IG → Personalizar)
IG_APP_SECRET=                        # Chave secreta do app do Instagram

# App principal Facebook (compartilhado entre Iris e Sensor Eleitoral)
META_APP_ID=                          # App ID do app principal (caso futuro Facebook Login)
META_APP_SECRET=                      # App Secret do app principal
META_GRAPH_API_VERSION=v25.0          # Versão Graph API (para chamadas via graph.facebook.com)

# OAuth flow
META_OAUTH_REDIRECT_URI=http://localhost:3010/api/meta/oauth/callback
META_OAUTH_STATE_SECRET=              # Secret aleatório p/ HMAC do state (32+ chars)

# Token encryption (AES-256-GCM)
META_TOKEN_ENCRYPTION_KEY=            # 64 hex chars (32 bytes). Gerar: openssl rand -hex 32
